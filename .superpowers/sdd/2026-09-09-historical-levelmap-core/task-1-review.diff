+def test_projection_preconditions_reject_unexpected_source_shapes_without_execution(old, new):
+    checker = audit()
+    text = (SOURCE / "chartdesk/levelmap.py").read_text(encoding="utf-8")
+    assert old in text
+    with pytest.raises(ValueError, match="SOURCE_"):
