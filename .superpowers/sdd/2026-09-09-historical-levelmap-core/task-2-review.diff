+
+
+def test_empty_intraday_prefix_is_unavailable_and_zero_age_does_not_relax():
+    spec = intraday()
+    empty = build(spec,T)
+    assert empty["blocker"] == "NO_EXPECTED_BARS" and empty["rows"] == []
+    stale = build(spec,T+8*STEP)
+    assert stale["blocker"] == "STALE" and stale["rows"] == []
