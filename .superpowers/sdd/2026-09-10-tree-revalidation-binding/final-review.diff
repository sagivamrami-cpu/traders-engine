+    source = RawSource()
+    bound = api().TreeRevalidation(source)
+    assert source.calls == []
+    assert bound.checks._tree_agrees(SYMBOL, 'לונג') == (
+        True, 'העץ נעצר ב-DATA: אין נתונים (LookupError)')
