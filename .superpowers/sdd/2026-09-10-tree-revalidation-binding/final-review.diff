+@pytest.mark.parametrize('inverse,side', [(False, 1), (True, -1)])
+def test_actual_matrix_reader_uses_original_requests_and_entire_delivered_frame(inverse, side):
+    source = RawSource()
+    df = falling(frame()) if inverse else frame()
