          "allOf": [
            {
              "contains": {
                "const": "OHLCV"
              }
            },
            {
              "contains": {
                "const": "ORDER_FLOW_VOLUME_DELTA_TRADES"
              }
            },
            {
              "contains": {
                "const": "ORDER_FLOW_CVD_FAMILY"
              }
            }
          ]
