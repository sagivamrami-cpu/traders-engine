        "future_manifest_requirements": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "allOf": [
            {
              "contains": {
                "const": "ONE_RECORDED_DROP_OR_MARK_POLICY_PER_FEATURE_FAMILY"
              }
            },
            {
              "contains": {
                "const": "EXCLUDED_OR_MARKED_ROW_COUNTS_BY_SPLIT"
              }
            },
            {
              "contains": {
                "const": "MISSING_EXPECTED_BAR_COUNTS_BY_TRADE_DATE"
              }
