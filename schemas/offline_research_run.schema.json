{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://traders-reality.local/schemas/offline_research_run.schema.json",
  "title": "OfflineResearchRun",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "run_version",
    "mode",
    "created_at",
    "raw_source_manifest",
    "normalized_bar_count",
    "snapshot_count",
    "candidate_count",
    "training_row_count",
    "included_training_row_count",
    "training_run",
    "safety_status",
    "blocked_actions",
    "blocked_reasons"
  ],
  "properties": {
    "run_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "run_version": {"type": "string", "const": "offline-research-run-0.1.0"},
    "mode": {"type": "string", "const": "LOCAL_CSV_DRY_RUN"},
    "created_at": {"type": "string", "format": "date-time"},
    "raw_source_manifest": {
      "type": "object",
      "required": ["source_id", "source_status", "raw_file_sha256", "row_count"],
      "additionalProperties": true,
      "properties": {
        "source_id": {"type": "string", "minLength": 1},
        "source_status": {"type": "string", "enum": ["OPEN_HUMAN_DECISION"]},
        "raw_file_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "row_count": {"type": "integer", "minimum": 0}
      }
    },
    "normalized_bar_count": {"type": "integer", "minimum": 0},
    "snapshot_count": {"type": "integer", "minimum": 0},
    "candidate_count": {"type": "integer", "minimum": 0},
    "training_row_count": {"type": "integer", "minimum": 0},
    "included_training_row_count": {"type": "integer", "minimum": 0},
    "training_run": {
      "type": "object",
      "required": ["status", "promotion_allowed", "blocked_reasons"],
      "additionalProperties": true,
      "properties": {
        "status": {"type": "string", "enum": ["TRAINED", "BLOCKED"]},
        "promotion_allowed": {"const": false},
        "blocked_reasons": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "safety_status": {"type": "string", "const": "BLOCKED_FOR_RESEARCH_ONLY"},
    "blocked_actions": {
      "type": "array",
      "minItems": 4,
      "items": {"type": "string", "minLength": 1}
    },
    "blocked_reasons": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
