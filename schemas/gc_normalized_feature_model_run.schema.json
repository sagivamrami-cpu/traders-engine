{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://traders-reality.local/schemas/gc_normalized_feature_model_run.schema.json",
  "title": "GcNormalizedFeatureModelRun",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "run_version",
    "status",
    "dataset_id",
    "dataset_version",
    "model_type",
    "model_version",
    "created_at",
    "training_policy_version",
    "feature_schema_version",
    "label_version",
    "source_feature_candidates_report_id",
    "source_feature_candidates_report_version",
    "source_previous_model_run_id",
    "source_baseline_run_id",
    "split_summary",
    "class_distribution",
    "fit_scope",
    "selection_scope",
    "final_evaluation_scope",
    "feature_names",
    "excluded_raw_features",
    "training_parameters",
    "selected_threshold",
    "threshold_selection_metric",
    "intercept",
    "coefficients",
    "metrics",
    "comparison_metrics",
    "blocked_reasons",
    "promotion_allowed"
  ],
  "properties": {
    "run_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "run_version": {"type": "string", "const": "gc-normalized-feature-model-run-0.1.0"},
    "status": {"type": "string", "enum": ["TRAINED", "BLOCKED"]},
    "dataset_id": {"type": "string", "minLength": 1},
    "dataset_version": {"type": "string", "minLength": 1},
    "model_type": {"type": "string", "const": "REGULARIZED_LOGISTIC_NORMALIZED_FEATURE_RESEARCH"},
    "model_version": {"type": ["string", "null"]},
    "created_at": {"type": "string", "format": "date-time"},
    "training_policy_version": {"type": "string", "minLength": 1},
    "feature_schema_version": {"type": "string", "minLength": 1},
    "label_version": {"type": ["string", "null"]},
    "source_feature_candidates_report_id": {"type": ["string", "null"]},
    "source_feature_candidates_report_version": {"type": ["string", "null"]},
    "source_previous_model_run_id": {"type": ["string", "null"]},
    "source_baseline_run_id": {"type": ["string", "null"]},
    "split_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["TRAIN", "VALIDATION", "TEST"],
      "properties": {
        "TRAIN": {"type": "integer", "minimum": 0},
        "VALIDATION": {"type": "integer", "minimum": 0},
        "TEST": {"type": "integer", "minimum": 0}
      }
    },
    "class_distribution": {
      "type": "object",
      "additionalProperties": {"type": "integer", "minimum": 0}
    },
    "fit_scope": {"type": "string", "const": "TRAIN_ONLY"},
    "selection_scope": {"type": "string", "const": "VALIDATION_ONLY"},
    "final_evaluation_scope": {"type": "string", "const": "TEST_ONLY"},
    "feature_names": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "excluded_raw_features": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["feature", "reason"],
        "properties": {
          "feature": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    },
    "training_parameters": {
      "type": "object",
      "additionalProperties": {"type": ["number", "integer", "string", "boolean", "null"]}
    },
    "selected_threshold": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "threshold_selection_metric": {"type": "string", "const": "validation_expected_r_per_candidate"},
    "intercept": {"type": ["number", "null"]},
    "coefficients": {
      "type": "object",
      "additionalProperties": {"type": "number"}
    },
    "metrics": {
      "type": "object",
      "additionalProperties": {"type": ["number", "integer", "null"]}
    },
    "comparison_metrics": {
      "type": "object",
      "additionalProperties": {"type": ["number", "integer", "string", "null"]}
    },
    "blocked_reasons": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "promotion_allowed": {"const": false}
  }
}
