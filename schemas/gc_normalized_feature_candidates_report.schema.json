{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://traders-reality.local/schemas/gc_normalized_feature_candidates_report.schema.json",
  "title": "GcNormalizedFeatureCandidatesReport",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "report_id",
    "report_version",
    "mode",
    "created_at",
    "status",
    "dataset_id",
    "variant",
    "source_feature_diagnostics_report_id",
    "source_feature_diagnostics_status",
    "included_rows_by_split",
    "research_training_allowed",
    "model_promotion_allowed",
    "next_model_feature_set",
    "approved_existing_features",
    "normalized_feature_definitions",
    "excluded_raw_features",
    "forbidden_feature_inputs",
    "feature_groups",
    "required_training_controls",
    "blocked_actions",
    "recommended_next_phase"
  ],
  "properties": {
    "report_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "report_version": {"type": "string", "const": "gc-normalized-feature-candidates-report-0.1.0"},
    "mode": {"type": "string", "const": "GC_NORMALIZED_FEATURE_CANDIDATES"},
    "created_at": {"type": "string", "format": "date-time"},
    "status": {"type": "string", "const": "NORMALIZED_FEATURE_CANDIDATES_READY"},
    "dataset_id": {"type": "string", "minLength": 1},
    "variant": {"type": "string", "const": "order_flow"},
    "source_feature_diagnostics_report_id": {"type": "string", "minLength": 1},
    "source_feature_diagnostics_status": {"type": "string", "const": "EXPERIMENT_DESIGN_REQUIRED"},
    "included_rows_by_split": {
      "type": "object",
      "additionalProperties": false,
      "required": ["TRAIN", "VALIDATION", "TEST"],
      "properties": {
        "TRAIN": {"type": "integer", "minimum": 0},
        "VALIDATION": {"type": "integer", "minimum": 0},
        "TEST": {"type": "integer", "minimum": 0}
      }
    },
    "research_training_allowed": {"const": true},
    "model_promotion_allowed": {"const": false},
    "next_model_feature_set": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1},
      "not": {
        "anyOf": [
          {"contains": {"const": "close"}},
          {"contains": {"const": "atr_14"}},
          {"contains": {"const": "outcome_class"}},
          {"contains": {"const": "net_return_r"}},
          {"contains": {"const": "time_to_outcome_bars"}},
          {"contains": {"const": "entry_price"}},
          {"contains": {"const": "target_price"}},
          {"contains": {"const": "stop_price"}},
          {"contains": {"const": "risk_r"}}
        ]
      }
    },
    "approved_existing_features": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "normalized_feature_definitions": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/normalizedFeatureDefinition"}
    },
    "excluded_raw_features": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/excludedRawFeature"}
    },
    "forbidden_feature_inputs": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "feature_groups": {
      "type": "object",
      "additionalProperties": false,
      "required": ["PRICE_RETURNS", "VOLATILITY_NORMALIZED", "ORDER_FLOW_NORMALIZED", "DIRECTION_CONTEXT"],
      "properties": {
        "PRICE_RETURNS": {"$ref": "#/$defs/featureNameList"},
        "VOLATILITY_NORMALIZED": {"$ref": "#/$defs/featureNameList"},
        "ORDER_FLOW_NORMALIZED": {"$ref": "#/$defs/featureNameList"},
        "DIRECTION_CONTEXT": {"$ref": "#/$defs/featureNameList"}
      }
    },
    "required_training_controls": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1},
      "allOf": [
        {"contains": {"const": "TRAIN_ONLY_IMPUTATION_AND_STANDARDIZATION"}},
        {"contains": {"const": "VALIDATION_ONLY_THRESHOLD_SELECTION"}},
        {"contains": {"const": "TEST_ONLY_FINAL_EVALUATION"}}
      ]
    },
    "blocked_actions": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1},
      "allOf": [
        {"contains": {"const": "MODEL_PROMOTION"}},
        {"contains": {"const": "LIVE_TRADING"}},
        {"contains": {"const": "BROKER_EXECUTION"}},
        {"contains": {"const": "CAPITAL_ALLOCATION"}},
        {"contains": {"const": "CLAIM_EDGE"}}
      ]
    },
    "recommended_next_phase": {"type": "string", "const": "PHASE_52_NORMALIZED_FEATURE_MODEL_RETRAINING"}
  },
  "$defs": {
    "featureNameList": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "normalizedFeatureDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "formula", "source_features", "zero_denominator_policy", "reason"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "formula": {"type": "string", "minLength": 1},
        "source_features": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "zero_denominator_policy": {
          "type": "string",
          "enum": ["NOT_APPLICABLE", "SET_NULL_THEN_TRAIN_SPLIT_IMPUTE"]
        },
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "excludedRawFeature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["feature", "reason"],
      "properties": {
        "feature": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1}
      }
    }
  }
}
