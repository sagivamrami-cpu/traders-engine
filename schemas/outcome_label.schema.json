{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "outcome_label.schema.json",
  "title": "OutcomeLabel",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "candidate_id",
    "label_version",
    "outcome_class",
    "target_before_stop",
    "stop_before_target",
    "expired",
    "net_return_r",
    "mae_r",
    "mfe_r",
    "time_to_outcome_bars",
    "filled",
    "realized_slippage_ticks",
    "label_quality"
  ],
  "properties": {
    "candidate_id": {
      "type": "string",
      "minLength": 1
    },
    "label_version": {
      "type": "string",
      "minLength": 1
    },
    "outcome_class": {
      "type": "string",
      "enum": [
        "TARGET_FIRST",
        "STOP_FIRST",
        "EXPIRED",
        "AMBIGUOUS"
      ]
    },
    "target_before_stop": {
      "type": "integer",
      "enum": [
        0,
        1
      ]
    },
    "stop_before_target": {
      "type": "integer",
      "enum": [
        0,
        1
      ]
    },
    "expired": {
      "type": "integer",
      "enum": [
        0,
        1
      ]
    },
    "net_return_r": {
      "type": [
        "number",
        "null"
      ]
    },
    "mae_r": {
      "type": [
        "number",
        "null"
      ]
    },
    "mfe_r": {
      "type": [
        "number",
        "null"
      ]
    },
    "time_to_outcome_bars": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "filled": {
      "type": "boolean"
    },
    "realized_slippage_ticks": {
      "type": [
        "number",
        "null"
      ]
    },
    "label_quality": {
      "type": "string",
      "enum": [
        "HIGH",
        "MEDIUM",
        "LOW",
        "EXCLUDED_FROM_TRAINING"
      ]
    }
  }
}
