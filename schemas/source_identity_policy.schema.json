{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://traders-reality.local/schemas/source_identity_policy.schema.json",
  "title": "SourceIdentityPolicy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "fixture_mode",
    "real_source",
    "allowed_deferred_producers",
    "blocked_actions"
  ],
  "properties": {
    "version": {"type": "string", "const": "source-identity-policy-0.1.0"},
    "fixture_mode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_ids", "canonical_symbols", "graph_ids", "dataset_ids"],
      "properties": {
        "source_ids": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "canonical_symbols": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "graph_ids": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "dataset_ids": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "real_source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required_metadata_fields",
        "allowed_source_statuses",
        "forbidden_identifier_prefixes",
        "forbidden_identifier_fragments"
      ],
      "properties": {
        "required_metadata_fields": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "allowed_source_statuses": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "forbidden_identifier_prefixes": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "forbidden_identifier_fragments": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "allowed_deferred_producers": {
      "type": "array",
      "items": {"type": "string", "enum": ["ORDER_FLOW", "OPTIONS"]}
    },
    "blocked_actions": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
