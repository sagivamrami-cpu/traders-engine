{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://traders-reality.local/schemas/real_data_readiness_report.schema.json",
  "title": "RealDataReadinessReport",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "report_id",
    "report_version",
    "created_at",
    "status",
    "checklist_version",
    "required_count",
    "satisfied_count",
    "open_count",
    "required_items",
    "blocked_actions",
    "blocked_reasons"
  ],
  "properties": {
    "report_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "report_version": {"type": "string", "const": "real-data-readiness-report-0.1.0"},
    "created_at": {"type": "string", "format": "date-time"},
    "status": {"type": "string", "enum": ["READY_FOR_PRODUCTION_DATASET", "BLOCKED"]},
    "checklist_version": {"type": "string", "minLength": 1},
    "required_count": {"type": "integer", "minimum": 0},
    "satisfied_count": {"type": "integer", "minimum": 0},
    "open_count": {"type": "integer", "minimum": 0},
    "required_items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["item_id", "label", "status", "owner", "required_before"],
        "properties": {
          "item_id": {"type": "string", "minLength": 1},
          "label": {"type": "string", "minLength": 1},
          "status": {"type": "string", "enum": ["SATISFIED", "OPEN_HUMAN_DECISION"]},
          "owner": {"type": "string", "minLength": 1},
          "required_before": {"type": "string", "minLength": 1}
        }
      }
    },
    "blocked_actions": {
      "type": "array",
      "minItems": 4,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "blocked_reasons": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    }
  }
}
