{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://traders-reality.local/schemas/databento_gc_order_flow_profile.schema.json",
  "title": "DatabentoGcOrderFlowProfile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile_id",
    "profile_version",
    "mode",
    "created_at",
    "status",
    "zip_path",
    "zip_sha256",
    "readme_present",
    "source_id",
    "vendor",
    "dataset",
    "canonical_symbol",
    "raw_symbol",
    "order_flow_source_decision_status",
    "options_source_decision_status",
    "parquet_files",
    "dbn_zst_files",
    "sampled_parquet_count",
    "parquet_entry_count",
    "dbn_zst_entry_count",
    "one_minute_order_flow_files",
    "one_minute_ohlcv_files",
    "raw_tick_files",
    "columns_by_file",
    "timestamp_column_by_file",
    "timezone_by_file",
    "row_count_by_file",
    "range_by_file",
    "known_damaged_aggressor_window",
    "cumulative_feature_policy_status",
    "contract_identity_status",
    "raw_tick_schema_family",
    "cumulative_column_status_by_file",
    "parquet_file_identity_status_by_file",
    "reference_4h_csv_status",
    "timeframe_status",
    "first_baseline_candidate",
    "macro_feature_status",
    "production_allowed",
    "dataset_construction_allowed",
    "training_allowed",
    "allowed_next_actions",
    "blocked_actions",
    "source_readiness_blockers",
    "blocked_reasons"
  ],
  "properties": {
    "profile_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "profile_version": {"type": "string", "const": "databento-gc-order-flow-profile-0.1.0"},
    "mode": {"type": "string", "const": "DATABENTO_GC_ORDER_FLOW_ZIP_PROFILE"},
    "created_at": {"type": "string", "format": "date-time"},
    "status": {
      "type": "string",
      "enum": ["BLOCKED", "ORDER_FLOW_PROFILE_SAMPLED_SOURCE_BLOCKED"]
    },
    "zip_path": {"type": "string", "const": "LOCAL_PATH_REDACTED"},
    "zip_sha256": {
      "anyOf": [
        {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        {"type": "null"}
      ]
    },
    "readme_present": {"type": "boolean"},
    "source_id": {"type": "string", "const": "databento-gc-order-flow"},
    "vendor": {"type": "string", "const": "DATABENTO"},
    "dataset": {"type": "string", "const": "GLBX.MDP3"},
    "canonical_symbol": {"type": "string", "const": "GC"},
    "raw_symbol": {"type": "string", "const": "GC"},
    "order_flow_source_decision_status": {"type": "string", "const": "OPEN_HUMAN_DECISION"},
    "options_source_decision_status": {"type": "string", "const": "DEFERRED_TO_V2_DO_NOT_QUERY"},
    "parquet_files": {"type": "array", "items": {"type": "string", "pattern": "^[^:]+\\.parquet$"}},
    "dbn_zst_files": {"type": "array", "items": {"type": "string", "pattern": "^[^:]+\\.dbn\\.zst$"}},
    "sampled_parquet_count": {"type": "integer", "minimum": 0},
    "parquet_entry_count": {"type": "integer", "minimum": 0},
    "dbn_zst_entry_count": {"type": "integer", "minimum": 0},
    "one_minute_order_flow_files": {"type": "array", "items": {"type": "string", "pattern": "^[^:]+\\.parquet$"}},
    "one_minute_ohlcv_files": {"type": "array", "items": {"type": "string", "pattern": "^[^:]+\\.parquet$"}},
    "raw_tick_files": {"type": "array", "items": {"type": "string", "pattern": "^[^:]+\\.dbn\\.zst$"}},
    "columns_by_file": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {"type": "string", "minLength": 1}
      }
    },
    "timestamp_column_by_file": {
      "type": "object",
      "additionalProperties": {
        "type": ["string", "null"],
        "minLength": 1
      }
    },
    "timezone_by_file": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "enum": ["UTC", "NAIVE_UTC_WALL_CLOCK_REQUIRES_LOCALIZE", "UNKNOWN"]
      }
    },
    "row_count_by_file": {
      "type": "object",
      "additionalProperties": {"type": "integer", "minimum": 0}
    },
    "range_by_file": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["start", "end"],
        "properties": {
          "start": {"type": ["string", "null"], "format": "date-time"},
          "end": {"type": ["string", "null"], "format": "date-time"}
        }
      }
    },
    "known_damaged_aggressor_window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "start", "end", "reason"],
      "properties": {
        "status": {"type": "string", "const": "EXCLUDE_FROM_ORDER_FLOW_FEATURES"},
        "start": {"type": "string", "format": "date-time"},
        "end": {"type": "string", "format": "date-time"},
        "reason": {"type": "string", "const": "DAMAGED_AGGRESSOR_SIDE_DELTA"}
      }
    },
    "cumulative_feature_policy_status": {
      "type": "string",
      "const": "BLOCKED_PENDING_PIT_ERA_GAP_POLICY"
    },
    "contract_identity_status": {
      "type": "string",
      "const": "UNDECLARED_PENDING_HUMAN_DECISION"
    },
    "raw_tick_schema_family": {"type": "string", "const": "UNPROFILED_NAME_ONLY"},
    "cumulative_column_status_by_file": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "enum": ["PRECOMPUTED_CUMULATIVE_UNSAFE", "NOT_PRESENT"]
      }
    },
    "parquet_file_identity_status_by_file": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "const": "UNDECLARED_SESSION_OR_IDENTITY_VARIANT"
      }
    },
    "reference_4h_csv_status": {"type": "string", "const": "REFERENCE_ONLY_DO_NOT_INGEST"},
    "timeframe_status": {"type": "string", "const": "BASELINE_APPROVED_V1_NOT_MODEL_FINAL"},
    "first_baseline_candidate": {"type": "string", "const": "30m_UTC_FIXED_BASELINE_APPROVED_V1"},
    "macro_feature_status": {
      "type": "string",
      "const": "REQUIRES_PER_SOURCE_DECISION_AND_LEAKAGE_GATE"
    },
    "production_allowed": {"const": false},
    "dataset_construction_allowed": {"const": false},
    "training_allowed": {"const": false},
    "allowed_next_actions": {"type": "array", "maxItems": 0},
    "blocked_actions": {
      "type": "array",
      "minItems": 17,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1},
      "allOf": [
        {"contains": {"const": "BUILD_ORDER_FLOW_FEATURES"}},
        {"contains": {"const": "BUILD_REAL_DATASET"}},
        {"contains": {"const": "TRAIN_PRODUCTION_MODEL"}},
        {"contains": {"const": "USE_ARCHIVED_CVD_COLUMN"}},
        {"contains": {"const": "INGEST_PRECOMPUTED_CVD"}},
        {"contains": {"const": "INGEST_ORDERFLOW_4H_CSV"}},
        {"contains": {"const": "JOIN_ORDERFLOW_4H_CSV_TO_TRAINING_ROWS"}},
        {"contains": {"const": "USE_HHLL_AS_TRADE_CONTRACT_LABEL"}},
        {"contains": {"const": "QUERY_OPTIONS_DATA"}},
        {"contains": {"const": "JOIN_MACRO_FEATURES"}},
        {"contains": {"const": "USE_REVISED_MACRO_SERIES"}},
        {"contains": {"const": "MAP_GC_TO_XAUUSD"}},
        {"contains": {"const": "MAP_GC_TO_GLD"}},
        {"contains": {"const": "INGEST_CONTINUOUS_OR_STITCHED_GC_SERIES"}},
        {"contains": {"const": "LIVE_TRADING"}},
        {"contains": {"const": "BROKER_EXECUTION"}},
        {"contains": {"const": "CAPITAL_ALLOCATION"}}
      ]
    },
    "source_readiness_blockers": {
      "type": "array",
      "minItems": 4,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1},
      "allOf": [
        {"contains": {"const": "ORDER_FLOW_SOURCE_DECISION_OPEN"}},
        {"contains": {"const": "CONTRACT_IDENTITY_UNDECLARED"}},
        {"contains": {"const": "ERA_MAP_UNMEASURED"}},
        {"contains": {"const": "PRECOMPUTED_CVD_COLUMN_UNSAFE"}}
      ]
    },
    "blocked_reasons": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"status": {"const": "ORDER_FLOW_PROFILE_SAMPLED_SOURCE_BLOCKED"}},
        "required": ["status"]
      },
      "then": {
        "properties": {
          "zip_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "readme_present": {"const": true},
          "parquet_entry_count": {"type": "integer", "minimum": 1},
          "dbn_zst_entry_count": {"type": "integer", "minimum": 1},
          "sampled_parquet_count": {"type": "integer", "minimum": 1},
          "blocked_reasons": {"maxItems": 0}
        }
      }
    }
  ]
}
