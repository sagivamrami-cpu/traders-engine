{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://traders-reality.local/schemas/gc_canonical_ohlcv_input_manifest.schema.json",
  "title": "GcCanonicalOhlcvInputManifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_id",
    "manifest_version",
    "mode",
    "created_at",
    "canonical_symbol",
    "status",
    "source_type",
    "source_decision_ref",
    "vendor_decision_ref",
    "symbol_decision_ref",
    "interval_decision_ref",
    "archive_sha256",
    "archive_size_bytes",
    "archive_member_count",
    "observed_first_at",
    "observed_last_at",
    "timestamp_role",
    "local_path",
    "canonical_ohlcv_input_gate_status",
    "dataset_identity_gate_status",
    "dataset_construction_allowed",
    "training_allowed",
    "blocked_actions",
    "blocked_reasons"
  ],
  "properties": {
    "manifest_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "manifest_version": {"type": "string", "const": "gc-canonical-ohlcv-input-manifest-0.1.0"},
    "mode": {"type": "string", "const": "GC_CANONICAL_OHLCV_INPUT_MANIFEST"},
    "created_at": {"type": "string", "format": "date-time"},
    "canonical_symbol": {"type": "string", "const": "GC"},
    "status": {"type": "string", "const": "CANONICAL_OHLCV_INPUT_RECORDED_NOT_DATASET_AUTHORIZED"},
    "source_type": {"type": "string", "const": "DATABENTO_LOCAL_GC_1S_ZIP"},
    "source_decision_ref": {
      "type": "string",
      "const": "agent-exchange/decisions/2026-08-31T175800Z-human-databento-gc-historical-data.md"
    },
    "vendor_decision_ref": {
      "type": "string",
      "const": "agent-exchange/decisions/2026-08-31T175801Z-human-databento-gc-vendor.md"
    },
    "symbol_decision_ref": {
      "type": "string",
      "const": "agent-exchange/decisions/2026-08-31T175802Z-human-first-symbol-gc.md"
    },
    "interval_decision_ref": {
      "type": "string",
      "const": "agent-exchange/decisions/2026-08-31T175803Z-human-first-historical-interval-gc.md"
    },
    "archive_sha256": {
      "type": "string",
      "const": "b59a9dd08a317162024d53c4f0841a68d68e51dfb66f5d9d62b140304c24c3d1"
    },
    "archive_size_bytes": {"type": "integer", "const": 984191105},
    "archive_member_count": {"type": "integer", "const": 195},
    "observed_first_at": {"type": "string", "const": "2010-06-07T00:00:02Z"},
    "observed_last_at": {"type": "string", "const": "2026-08-05T23:59:49Z"},
    "timestamp_role": {"type": "string", "const": "TS_EVENT_INTERVAL_START_APPROVED_V1"},
    "local_path": {"type": "string", "const": "LOCAL_PATH_REDACTED"},
    "canonical_ohlcv_input_gate_status": {"type": "string", "const": "SATISFIED_FOR_OHLCV_ONLY"},
    "dataset_identity_gate_status": {"type": "string", "const": "UNSATISFIED_PARTIAL_INPUT_IDENTITY_ONLY"},
    "dataset_construction_allowed": {"const": false},
    "training_allowed": {"const": false},
    "blocked_actions": {
      "type": "array",
      "minItems": 4,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1},
      "allOf": [
        {"contains": {"const": "BUILD_REAL_DATASET"}},
        {"contains": {"const": "RESAMPLE_REAL_BARS"}},
        {"contains": {"const": "BUILD_REAL_LABELS"}},
        {"contains": {"const": "TRAIN_PRODUCTION_MODEL"}}
      ]
    },
    "blocked_reasons": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1},
      "allOf": [
        {"contains": {"const": "DATASET_IDENTITY_GATE_UNSATISFIED_PARTIAL_INPUT_IDENTITY_ONLY"}},
        {"contains": {"const": "CANONICAL_ORDER_FLOW_INPUT_GATE_UNSATISFIED"}},
        {"contains": {"const": "DATASET_CONSTRUCTION_AUTHORIZATION_MISSING"}}
      ]
    }
  }
}
