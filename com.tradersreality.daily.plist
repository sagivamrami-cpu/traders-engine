<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.tradersreality.daily</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/sagivamram/traders-engine/.venv/bin/python</string>
        <string>/Users/sagivamram/traders-engine/run_daily.py</string>
        <string>--count</string>
        <string>5</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/sagivamram/traders-engine</string>

    <!-- Runs every day at 09:00 local time. If the Mac was asleep at 09:00,
         launchd runs it once when the Mac next wakes. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>9</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/sagivamram/traders-engine/logs/run.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/sagivamram/traders-engine/logs/run.err.log</string>
</dict>
</plist>
